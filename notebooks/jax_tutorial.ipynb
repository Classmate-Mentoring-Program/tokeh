   ],
   "source": [
    "# Create a simple array\n",
    "x = jnp.array([1, 2, 3])\n",
    "y = jnp.array([4, 5, 6])\n",
    "\n",
    "\n",
    "# mse function\n",
    "def mse(a: jnp.ndarray, b: jnp.ndarray) -> jnp.ndarray:\n",
    "    return ((a - b) ** 2).mean()\n",
    "\n",
    "\n",
    "mse(x, y)"
   ]
